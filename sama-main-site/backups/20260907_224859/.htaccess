Options +ExecCGI
AddHandler cgi-script .cgi
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
RewriteEngine On
RewriteRule \.(py|pyc|db|zip|json)$ - [R=404,L]
RewriteRule ^sama_auth\.conf$ - [R=404,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^cgi-bin/ - [L]
RewriteRule ^(.*)$ cgi-bin/sama_test.cgi/$1 [L,QSA]
Header always set Content-Security-Policy-Report-Only "default-src 'self' https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self';"
