# Private server-only configuration. Copy to /etc/sama-contact.env (root:root 0600).
# Do not source this file in a shell or upload real credentials to GitHub.
SMTP_HOST=CHANGE_ME_FROM_NATRO_PANEL
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=operations@sama-transports.com
SMTP_PASSWORD=CHANGE_ME
CONTACT_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
API_HOST=forms.sama-transports.com
ALLOWED_ORIGINS=https://sama-transports.com,https://www.sama-transports.com
STATE_PATH=/var/lib/sama-contact/state.sqlite3
CLAMAV_SOCKET=/run/clamav/clamd.ctl
