RewriteEngine On

# Keep the public endpoint HTTPS once SSL is enabled in konsoleH.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^track\.sama-transports\.com$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]

# SAMA TRACK runs privately on the same Hetzner account.
RewriteCond %{HTTP_HOST} ^track\.sama-transports\.com$ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:18080/$1 [P,L]
